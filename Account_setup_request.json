    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\n\n// Define character sets\nconst upper = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\nconst lower = \"abcdefghijklmnopqrstuvwxyz\";\nconst numbers = \"0123456789\";\nconst symbols = \"!@#$%^&*()_+=-[]{}|;:,.<>?/`~\";\n\n// Combine all sets\nconst allChars = upper + lower + numbers + symbols;\n\n// Helper: get secure random index\nconst randomIndex = (length) => crypto.randomInt(0, length);\n\n// Generate a strong password\nlet password = \"\";\n\n// Ensure at least one from each category for guaranteed complexity\npassword += upper[randomIndex(upper.length)];\npassword += lower[randomIndex(lower.length)];\npassword += numbers[randomIndex(numbers.length)];\npassword += symbols[randomIndex(symbols.length)];\n\n// Fill the rest (12 total, or more if you like)\nfor (let i = password.length; i < 16; i++) {\n  password += allChars[randomIndex(allChars.length)];\n}\n\n// Optional: Shuffle to remove predictable placement\npassword = password.split('').sort(() => 0.5 - Math.random()).join('');\n\nreturn [{ json: { password }, pairedItem: 0 }];\n"
      },
